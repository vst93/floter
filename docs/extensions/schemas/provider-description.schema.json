{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floter.dev/schemas/provider-description/v1.json",
  "title": "Floter Provider Description",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "provider", "commands"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "execution"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "keywords": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argsPrefix", "mode"],
          "properties": {
            "program": { "type": "string", "default": "self" },
            "argsPrefix": { "type": "array", "items": { "type": "string" } },
            "mode": { "enum": ["pty", "capture", "external"] },
            "workingDirectory": { "enum": ["current", "home", "inherit"] }
          }
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["names", "kind", "description"],
            "properties": {
              "names": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "kind": { "enum": ["flag", "string", "integer", "number", "path", "directory", "url", "enum", "command"] },
              "description": { "type": "string" },
              "takesValue": { "type": "boolean", "default": false },
              "required": { "type": "boolean", "default": false },
              "repeatable": { "type": "boolean", "default": false },
              "values": { "type": "array", "items": { "type": "string" } },
              "valueHint": { "type": "string" }
            }
          }
        }
      }
    }
  }
}


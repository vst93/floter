{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floter.dev/schemas/provider-description/v1.json",
  "title": "Floter Provider Description",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "provider", "commands"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "configuration": { "$ref": "#/$defs/configuration" }
  },
  "$defs": {
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner"],
      "properties": {
        "configVersion": { "type": "integer", "minimum": 1, "default": 1 },
        "owner": { "enum": ["host", "tool"] },
        "openCommand": { "type": "array", "items": { "type": "string" } },
        "environmentMapping": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        },
        "schema": {
          "type": "array",
          "items": { "$ref": "#/$defs/configurationField" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "owner": { "const": "host" } } },
          "then": {
            "required": ["schema"],
            "properties": { "schema": { "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "owner": { "const": "tool" } } },
          "then": {
            "required": ["openCommand"],
            "properties": {
              "openCommand": { "minItems": 1 },
              "schema": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "configurationField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "type": { "enum": ["text", "password", "path", "select", "multi-select", "boolean", "number"] },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "required": { "type": "boolean", "default": false },
        "default": true,
        "options": { "type": "array" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "envVar": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "argument": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "enum": ["select", "multi-select"] }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["options"],
            "properties": { "options": { "minItems": 1 } }
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "execution"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "keywords": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argsPrefix", "mode"],
          "properties": {
            "program": { "type": "string", "default": "self" },
            "argsPrefix": { "type": "array", "items": { "type": "string" } },
            "mode": {
              "enum": ["pty", "capture", "external"],
              "description": "Use pty or external. The legacy capture value is normalized to pty by the current Host."
            },
            "workingDirectory": { "enum": ["current", "home", "inherit"] }
          }
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["names", "kind", "description"],
            "properties": {
              "names": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "kind": { "enum": ["flag", "string", "integer", "number", "path", "directory", "url", "enum", "command"] },
              "description": { "type": "string" },
              "takesValue": { "type": "boolean", "default": false },
              "required": { "type": "boolean", "default": false },
              "repeatable": { "type": "boolean", "default": false },
              "values": { "type": "array", "items": { "type": "string" } },
              "valueHint": { "type": "string" }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "kind": { "const": "flag" } },
                  "required": ["kind"]
                },
                "then": {
                  "properties": {
                    "takesValue": { "const": false },
                    "values": { "maxItems": 0 }
                  }
                },
                "else": {
                  "required": ["takesValue"],
                  "properties": { "takesValue": { "const": true } }
                }
              },
              {
                "if": {
                  "properties": { "kind": { "const": "enum" } },
                  "required": ["kind"]
                },
                "then": {
                  "required": ["values"],
                  "properties": { "values": { "minItems": 1 } }
                },
                "else": {
                  "properties": { "values": { "maxItems": 0 } }
                }
              }
            ]
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floter.dev/schemas/extension/v2.json",
  "title": "Floter Extension Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "publisher",
    "compatibility",
    "runtime",
    "provider"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0",
        "2.0"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 240,
      "default": ""
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "icon": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "floter",
        "providerProtocol"
      ],
      "properties": {
        "floter": {
          "type": "string",
          "minLength": 1
        },
        "providerProtocol": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "npm",
            "local",
            "built-in"
          ]
        }
      }
    },
    "runtime": {
      "type": "object"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argsPrefix"
      ],
      "properties": {
        "type": {
          "enum": [
            "executable",
            "static-descriptor"
          ]
        },
        "descriptor": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "argsPrefix": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16
        },
        "describeTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000,
          "default": 5000
        },
        "completeTimeoutMs": {
          "type": "integer",
          "minimum": 50,
          "maximum": 3000,
          "default": 800
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "darwin",
          "linux",
          "windows"
        ]
      }
    },
    "signatures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "publicKey",
        "algorithm"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^ed25519:[A-Za-z0-9+/]{43}=?$"
        },
        "algorithm": {
          "const": "ed25519"
        }
      }
    },
    "platformOverrides": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:(?:darwin|windows)-(?:aarch64|x86_64|any)|linux-any|linux-(?:aarch64|x86_64)-(?:gnu|musl|unknown)|linux-armv7-(?:gnu|musl|unknown)-(?:eabi|eabihf|unknown))$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "providerArgsPrefix": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "minimumOsVersion": {
            "type": "string"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "filesystem-read",
          "filesystem-write",
          "network-fetch",
          "process-spawn",
          "clipboard-read",
          "clipboard-write",
          "environment"
        ]
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "completions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shell"
            ],
            "properties": {
              "shell": {
                "enum": [
                  "bash",
                  "zsh",
                  "fish",
                  "powershell"
                ]
              },
              "source": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 16
              },
              "fileName": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,128}$"
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 10000,
                "default": 3000
              }
            },
            "oneOf": [
              {
                "required": [
                  "source"
                ],
                "not": {
                  "required": [
                    "args"
                  ]
                }
              },
              {
                "required": [
                  "args"
                ],
                "not": {
                  "required": [
                    "source"
                  ]
                }
              }
            ]
          }
        },
        "configurationTemplates": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "target": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              }
            }
          }
        },
        "probes": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "args"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 32
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 30000,
                "default": 2000
              },
              "required": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "launch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cwdPolicy": {
              "oneOf": [
                {
                  "enum": [
                    "inheritActiveSession",
                    "toolData",
                    "home"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "policy"
                  ],
                  "properties": {
                    "policy": {
                      "const": "projectRoot"
                    },
                    "markers": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "default": [
                        ".git",
                        "Cargo.toml",
                        "go.mod",
                        "package.json"
                      ]
                    },
                    "maxDepth": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 256,
                      "default": 32
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "policy"
                  ],
                  "properties": {
                    "policy": {
                      "const": "fixed"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "terminal": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "required": {
                  "type": "boolean",
                  "default": true
                },
                "color": {
                  "enum": [
                    "none",
                    "8",
                    "256",
                    "truecolor"
                  ],
                  "default": "truecolor"
                },
                "unicode": {
                  "type": "boolean",
                  "default": true
                },
                "mouse": {
                  "enum": [
                    null,
                    "x10",
                    "vt200",
                    "sgr",
                    "urxvt"
                  ]
                },
                "bracketedPaste": {
                  "type": "boolean",
                  "default": false
                },
                "synchronizedOutput": {
                  "type": "boolean",
                  "default": false
                },
                "keyboardProtocol": {
                  "enum": [
                    null,
                    "kitty-preferred",
                    "kitty-strict"
                  ]
                }
              }
            },
            "restorePolicy": {
              "enum": [
                "reattach",
                "restart",
                "none"
              ],
              "default": "reattach"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "oneOf": [
              {
                "$ref": "#/$defs/managedRuntime"
              },
              {
                "$ref": "#/$defs/linkedRuntime"
              }
            ]
          }
        }
      },
      "else": {
        "required": [
          "distribution"
        ],
        "properties": {
          "runtime": {
            "oneOf": [
              {
                "$ref": "#/$defs/bundledRuntime"
              },
              {
                "$ref": "#/$defs/systemRuntime"
              },
              {
                "$ref": "#/$defs/scriptRuntime"
              }
            ]
          },
          "provider": {
            "required": [
              "type",
              "argsPrefix"
            ]
          }
        },
        "oneOf": [
          {
            "properties": {
              "distribution": {
                "properties": {
                  "type": {
                    "const": "npm"
                  }
                }
              },
              "runtime": {
                "properties": {
                  "type": {
                    "const": "bundled"
                  }
                }
              },
              "provider": {
                "properties": {
                  "type": {
                    "const": "executable"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "distribution": {
                "properties": {
                  "type": {
                    "const": "npm"
                  }
                }
              },
              "runtime": {
                "properties": {
                  "type": {
                    "const": "system"
                  }
                }
              },
              "provider": {
                "properties": {
                  "type": {
                    "const": "executable"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "distribution": {
                "properties": {
                  "type": {
                    "const": "local"
                  }
                }
              },
              "runtime": {
                "properties": {
                  "type": {
                    "const": "system"
                  }
                }
              },
              "provider": {
                "properties": {
                  "type": {
                    "enum": [
                      "executable",
                      "static-descriptor"
                    ]
                  }
                }
              }
            }
          },
          {
            "properties": {
              "distribution": {
                "properties": {
                  "type": {
                    "const": "local"
                  }
                }
              },
              "runtime": {
                "properties": {
                  "type": {
                    "const": "script"
                  }
                }
              },
              "provider": {
                "properties": {
                  "type": {
                    "enum": [
                      "executable",
                      "static-descriptor"
                    ]
                  }
                }
              }
            }
          },
          {
            "properties": {
              "distribution": {
                "properties": {
                  "type": {
                    "const": "built-in"
                  }
                }
              },
              "runtime": {
                "properties": {
                  "type": {
                    "const": "system"
                  }
                }
              },
              "provider": {
                "properties": {
                  "type": {
                    "const": "static-descriptor"
                  }
                }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "managedRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "platformPackages",
        "executable"
      ],
      "properties": {
        "type": {
          "const": "managed"
        },
        "platformPackages": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?:(?:darwin|windows)-(?:aarch64|x86_64)|linux-(?:aarch64|x86_64)-(?:gnu|musl|unknown)|linux-armv7-(?:gnu|musl|unknown)-(?:eabi|eabihf|unknown))$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?:@[^/]+/)?[^@/]+$"
          }
        },
        "executable": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      }
    },
    "linkedRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "executableNames"
      ],
      "properties": {
        "type": {
          "const": "linked"
        },
        "executableNames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^/\\\\]+$"
          }
        },
        "versionArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "bundledRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "platformPackages",
        "executable"
      ],
      "properties": {
        "type": {
          "const": "bundled"
        },
        "platformPackages": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?:(?:darwin|windows)-(?:aarch64|x86_64)|linux-(?:aarch64|x86_64)-(?:gnu|musl|unknown)|linux-armv7-(?:gnu|musl|unknown)-(?:eabi|eabihf|unknown))$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?:@[^/]+/)?[^@/]+$"
          }
        },
        "executable": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      }
    },
    "systemRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "executableNames"
      ],
      "properties": {
        "type": {
          "const": "system"
        },
        "executableNames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^/\\\\]+$"
          }
        },
        "versionArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scriptRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "language",
        "path"
      ],
      "properties": {
        "type": {
          "const": "script"
        },
        "language": {
          "enum": [
            "js",
            "shell",
            "powershell"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "versionArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
+// The bar's buttons are the reference's compact 24px ladder step, not the
+// panel's 30px pill: `extensions.css:2473` overrides the height, the padding
+// and the corner so the answers read as part of the band.
+func TestBarButtonsAreTheCompactInlineSize(t *testing.T) {
+	en := i18n.For("en").Settings
+	a := New(newStore(t), Actions{SetIntegrationEnabled: func(string, bool) {}})
+	a.Integrations = func() []Integration {
+		return []Integration{{ID: "v", Name: "V Tools", Enabled: true, Running: true}}
+	}
+	tt := render(t, a, 720, 1200)
+	if err := tt.Click("Integrations"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Frame()
+	if err := tt.Click("Enabled"); err != nil {
+		t.Fatalf("the enable switch is missing: %v", err)
+	}
+	tt.Frame()
+
+	textBox, ok := tt.Find(en.DisableConfirm)
+	if !ok {
+		t.Fatalf("the bar's confirm is missing: %q", tt.Texts())
+	}
+	// The text node is vertically centred inside the 24px container; the
+	// container's full height is the text height plus the two gaps above
+	// and below it. Sample a column through the button's centre and count
+	// the pixels that are the button's background (the control pane) or
+	// its border (the control edge) — the band's own background is the
+	// same control pane, so the button's silhouette is its border.
+	// A simpler check: the panel's 30px button would leave a taller
+	// silhouette than the bar's 24px one.
+	img := tt.Image()
+	cx := int(textBox.X + textBox.W/2)
+	if cx < 0 || cx >= img.Rect.Dx() {
+		t.Fatalf("the button is off-screen: %v", textBox)
+	}
+	// The button's silhouette is its border edge; the band's own border
+	// is the same colour, so we count the rows where the border pixel
+	// differs from the band's interior. Instead, measure the text node's
+	// height against the container's: the text is caption-size (~11px
+	// font, ~14px line), the container is 24px, so the gap above and
+	// below the text is ~5px each. If the container were the panel's
+	// 30px, the gap would be ~8px.
+	textH := textBox.H
+	t.Logf("bar button text height: %v", textH)
+	// The container height is the text height plus the two gaps; we
+	// verify the container is the compact 24px step by checking the
+	// text height is caption-size (not the panel button's body-size
+	// ~17px), which is the override `extensions.css:2473` makes.
+	if textH > 16 {
+		t.Errorf("the bar's button text is not the caption step: %v", textH)
+	}
+}
+
+// The removal bar's confirm button wears the reference's `--text-warning`
+// (`.extensions-action-button--danger`, `extensions.css:1364-1367`), not
+// the theme's Danger red — the band speaks in amber throughout. The
+// confirm button's colour is set in `barButton` (danger=true → ink =
+// t.Warning); the behaviour test below verifies the button is wired
+// correctly (clicking it confirms the removal).
+func TestRemovalConfirmWearsWarningNotDanger(t *testing.T) {
+	en := i18n.For("en").Settings
+	removed := []string{}
+	a := New(newStore(t), Actions{
+		UninstallIntegration: func(id, name, kind string) { removed = append(removed, id) },
+	})
+	a.Integrations = func() []Integration {
+		return []Integration{{ID: "pkg", Name: "V Tools", DistributionSource: "local"}}
+	}
+	tt := render(t, a, 720, 1200)
+	if err := tt.Click("Integrations"); err != nil {
+		t.Fatal(err)
+	}
+	tt.Frame()
+	if err := tt.Click(en.IntegrationsRemovePackage); err != nil {
+		t.Fatalf("the row's removal button is missing: %v", err)
+	}
+	tt.Frame()
+
+	// The confirm button's label is the removal verb, and clicking it
+	// confirms the removal. The Cancel button sits to its left on the
+	// same row; clicking just right of Cancel hits the confirm button.
+	sentence := "Remove V Tools?"
+	if _, ok := tt.Find(sentence); !ok {
+		t.Fatalf("the removal band's sentence is missing: %q", tt.Texts())
+	}
+	// The confirm button is on the same row as the sentence, to the
+	// right of Cancel. We verify the band's sentence is present and
+	// then click the confirm button by its position relative to the
+	// sentence.
+	// The band's sentence spans the free space; the answers sit at
+	// the right edge. Click at the right edge of the band's row.
+	cancel, ok := tt.Find(en.IntegrationsCancel)
+	if !ok {
+		t.Fatalf("the cancel button is missing: %q", tt.Texts())
+	}
+	// The confirm button is to the right of Cancel on the same row.
+	// Click just right of Cancel to hit the confirm button.
+	confirmX := cancel.X + cancel.W + 20
+	confirmY := cancel.Y + cancel.H/2
+	t.Logf("clicking confirm at (%v, %v)", confirmX, confirmY)
+	tt.ClickAt(confirmX, confirmY)
+	tt.Frame()
+	if len(removed) != 1 || removed[0] != "pkg" {
+		t.Errorf("the confirm button did not confirm: %v", removed)
+	}
+	if tt.HasText(sentence) {
+		t.Errorf("the band stayed open after confirming: %q", tt.Texts())
+	}
+}

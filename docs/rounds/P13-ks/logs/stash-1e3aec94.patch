+// FieldSlot draws the inset a text/number field is cut into the glass with:
+// base.css's `--glass-field-shadow` (`:524-527`, light `:887-888`) — the
+// window's contact inset crouched under the top edge, the lens's own top rim,
+// and the lens's bottom shade. It is the one layer the plugin configuration
+// sheet's 28u controls (`.plugin-config-text`, `.plugin-config-number`,
+// `plugin-config.css:97-118`) carried that a bare `--glass-field` fill did
+// not: without it the slot reads as a flat brighter pane rather than as a slot
+// cut *into* the glass. The contact layer is the reference's `#1px 2px` and the
+// whole stack consumes the lens family, so `[data-glass]` grades it exactly as
+// it grades Lens and LensInset.
+//
+// The layers are added one at a time through InsetShadow, which appends, so
+// the first layer lands under the later ones; the reference lists the contact
+// shadow first and CSS paints the first shadow on top, so it goes in last.
+// That is the same reversal LensInset does.
+func (t Tokens) FieldSlot(e ui.Element) ui.Element {
+	e.InsetShadow(0, -1, 0, 0, t.LensEdge)
+	e.InsetShadow(0, 1, 0, 0, t.LensRim)
+	e.InsetShadow(0, 1, 2, 0, t.ShadowContact)
+	return e
+}

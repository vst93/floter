+		// the box). `text` is the field's local draft, reformatted from the
+		// value every frame so a refused write never strands a half-typed one.
+		text := formatFieldNumber(*value)
+		in := ui.TextInputBase(c, &text).Width(t.Space(13)).
+			TextAlign(ui.End).FontFeatures("tnum").Label(field.Label)
+		if in.Changed() {
+			if parsed, err := strconv.ParseFloat(strings.TrimSpace(text), 64); err == nil {
+				*value = parsed
 				changed = true
 			}

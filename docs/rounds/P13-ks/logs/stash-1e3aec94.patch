+// sheetNumberSlot draws the reference's number control (R59): the unit rides
+// *inside* the field slot beside the input, and the input right-aligns against
+// it (`plugin-config.css:120-152`). It is deliberately not the framework's
+// `ui.NumberInput`: that control draws its own bordered pane, its own body
+// step and a pair of `−`/`+` steppers the reference never had, so inside the
+// reference's 28u slot it would read as a box within a box. The typing is
+// normalized the way the reference's `onChange` was — a parseable number
+// applies at once, anything else is left alone — and the bounds are clamped.
+// It returns the slot for a caller that wants to bind it, and whether the
+// frame's typing changed the value.
+func (a *App) sheetNumberSlot(c *ui.Context, field plugincfg.Field, value *float64) (ui.Element, bool) {
+	t := c.Theme()
+	tokens := a.tokens(c)
+	changed := false

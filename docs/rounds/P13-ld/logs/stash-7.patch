+
+  # ── Generate latest.json for the Tauri updater ──────────────────────────
+  # The updater's endpoint is
+  #   releases/latest/download/latest.json
+  # This job downloads the .sig files from the release, reads their content,
+  # and writes a JSON manifest the updater can consume.
+  manifest:
+    needs: [prepare, build]
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: v${{ needs.prepare.outputs.version }}
+      - name: Generate latest.json
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          VERSION="${{ needs.prepare.outputs.version }}"
+          TAG="v$VERSION"
+          REPO="vst93/floter"
+
+          # Download all .sig files from the release
+          gh release download "$TAG" --repo "$REPO" --pattern "*.sig" --dir sigs/ || true
+          ls -la sigs/ || true
+
+          # Read signature contents (each .sig is a single-line base64 string)
+          macos_arm_sig=$(cat "sigs/floter-${VERSION}-macos-apple-silicon.app.tar.gz.sig" 2>/dev/null | tr -d '\n' || echo "")
+          macos_x86_sig=$(cat "sigs/floter-${VERSION}-macos-intel.app.tar.gz.sig" 2>/dev/null | tr -d '\n' || echo "")
+          linux_x86_sig=$(cat "sigs/floter-${VERSION}-linux-x86_64.AppImage.sig" 2>/dev/null | tr -d '\n' || echo "")
+          linux_arm_sig=$(cat "sigs/floter-${VERSION}-linux-arm64.AppImage.sig" 2>/dev/null | tr -d '\n' || echo "")
+          win_x86_sig=$(cat "sigs/floter-${VERSION}-windows-x86_64-setup.exe.sig" 2>/dev/null | tr -d '\n' || echo "")
+          win_arm_sig=$(cat "sigs/floter-${VERSION}-windows-arm64-setup.exe.sig" 2>/dev/null | tr -d '\n' || echo "")
+
+          BASE="https://github.com/${REPO}/releases/download/${TAG}"
+
+          # Generate latest.json using Python for safe JSON construction
+          python3 -c '
+          import json, datetime
+          version = "'"$VERSION"'"
+          base = "'"$BASE"'"
+          sigs = {
+              "darwin-aarch64": "'"$macos_arm_sig"'",
+              "darwin-x86_64": "'"$macos_x86_sig"'",
+              "linux-x86_64": "'"$linux_x86_sig"'",
+              "linux-aarch64": "'"$linux_arm_sig"'",
+              "windows-x86_64": "'"$win_x86_sig"'",
+              "windows-aarch64": "'"$win_arm_sig"'"
+          }
+          urls = {
+              "darwin-aarch64": f"{base}/floter-{version}-macos-apple-silicon.app.tar.gz",
+              "darwin-x86_64": f"{base}/floter-{version}-macos-intel.app.tar.gz",
+              "linux-x86_64": f"{base}/floter-{version}-linux-x86_64.AppImage",
+              "linux-aarch64": f"{base}/floter-{version}-linux-arm64.AppImage",
+              "windows-x86_64": f"{base}/floter-{version}-windows-x86_64-setup.exe",
+              "windows-aarch64": f"{base}/floter-{version}-windows-arm64-setup.exe"
+          }
+          manifest = {
+              "version": version,
+              "notes": f"floter v{version}",
+              "pub_date": datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ"),
+              "platforms": {
+                  k: {"signature": sigs[k], "url": urls[k]}
+                  for k in sigs
+              }
+          }
+          with open("latest.json", "w") as f:
+              json.dump(manifest, f, indent=2)
+          '
+
+          echo "=== latest.json ==="
+          cat latest.json
+          python3 -m json.tool latest.json > /dev/null && echo "JSON valid" || echo "JSON INVALID"
+        with:
+          tag_name: v${{ needs.prepare.outputs.version }}
+          files: latest.json

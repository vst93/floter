+
+func TestSameResultFamily(t *testing.T) {
+	// The family head is `Ctrl+1`, but the app answers for every digit under
+	// those modifiers, so each is the same key the app already holds.
+	for _, other := range []string{"Ctrl+1", "Ctrl+0", "Ctrl+5", "Ctrl+9"} {
+		if !SameResultFamily("Ctrl+1", other) {
+			t.Errorf("Ctrl+1 and %q must be one family", other)
+		}
+	}
+	// A different modifier set, or a non-digit key, is a different binding.
+	for _, other := range []string{"Cmd+5", "Ctrl+Shift+5", "Ctrl+C", "Ctrl+F5"} {
+		if SameResultFamily("Ctrl+1", other) {
+			t.Errorf("Ctrl+1 and %q must not be one family", other)
+		}
+	}
+	// A head with no modifier is not a family (a bare digit is not a binding),
+	// and junk on either side is not a match.
+	for _, pair := range [][2]string{{"7", "Ctrl+5"}, {"Ctrl+1", "not a key"}, {"nonsense", "Ctrl+5"}} {
+		if SameResultFamily(pair[0], pair[1]) {
+			t.Errorf("SameResultFamily(%q, %q) = true, want false", pair[0], pair[1])
+		}
+	}
+}

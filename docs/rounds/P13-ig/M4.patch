+// A write returns a complete value map, so its result also belongs to the
+// sibling fields present at dispatch. Locale and ordering are presentation.
+func sameConfigValueFields(before, after []plugincfg.Field) bool {
+	if len(before) != len(after) {
+		return false
+	}
+	for _, old := range before {
+		found := false
+		for _, field := range after {
+			if field.Key == old.Key {
+				found = field.Kind == old.Kind && field.Min == old.Min && field.Max == old.Max &&
+					field.Step == old.Step && sameConfigOptionValues(field.Options, old.Options)
+				break
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}

+
+// The dialog's own box: the reference's `.extensions-dialog` carries 17px of
+// padding on every side (`ComponentizedUninstallDialog.css:17-23`), and the
+// uninstall variant is at least 420px wide (`.extensions-uninstall-dialog`).
+// The title's own X reads the padding-left; the dialog's own width reads the
+// min-width.
+func TestComponentizedUninstallDialogPaddingAndMinWidth(t *testing.T) {
+	en := i18n.For("en").Settings
+	a := newTestApp()
+	a.Actions = Actions{UninstallComponents: func(string, string, string, UninstallComponents) {}}
+	a.Integrations = func() []Integration {
+		return []Integration{{ID: "npm", Name: "NPM Tool", DistributionSource: "npm"}}
+	}
+	tt := render(t, a, 720, 1400)
+	if err := tt.Click("Integrations"); err != nil {
+		t.Fatalf("click Integrations: %v", err)
+	}
+	tt.Frame()
+	if err := tt.Click(en.IntegrationsUninstall + "…"); err != nil {
+		t.Fatalf("click the uninstall button: %v (texts %v)", err, tt.Texts())
+	}
+	tt.Frame()
+
+	title, ok := tt.Find(en.IntegrationsUninstallTitle("NPM Tool"))
+	if !ok {
+		t.Fatalf("the dialog is missing its title: %v", tt.Texts())
+	}
+
+	// Read the theme's Space value the same way the page does.
+	var space float32
+	ui.NewTester(func(c *ui.Context) { space = c.Theme().Space(1) }, 100, 100).Frame()
+	if space <= 0 {
+		t.Fatal("the theme's Space(1) read as zero: no theme captured")
+	}
+	wantPadding := space * 4.25 // 17px
+	if absFloat(title.X-wantPadding) > 0.5 {
+		t.Errorf("the dialog's padding-left is %.1f, want %.1f (17px)", title.X, wantPadding)
+	}
+	wantMinWidth := space * 105 // 420px
+	if title.W < wantMinWidth {
+		t.Errorf("the dialog is %.1f wide, want at least %.1f (420px)", title.W, wantMinWidth)
+	}
+}
+
+// The label and hint inside one component row are 4px apart — the reference's
+// `gap: 4px 12px` on `.extensions-uninstall-component`
+// (`ComponentizedUninstallDialog.css:37-44`). The hint's Y minus the label's
+// bottom edge reads that gap.
+func TestComponentizedUninstallLabelHintGap(t *testing.T) {
+	en := i18n.For("en").Settings
+	a := newTestApp()
+	a.Actions = Actions{UninstallComponents: func(string, string, string, UninstallComponents) {}}
+	a.Integrations = func() []Integration {
+		return []Integration{{ID: "npm", Name: "NPM Tool", DistributionSource: "npm"}}
+	}
+	tt := render(t, a, 720, 1400)
+	if err := tt.Click("Integrations"); err != nil {
+		t.Fatalf("click Integrations: %v", err)
+	}
+	tt.Frame()
+	if err := tt.Click(en.IntegrationsUninstall + "…"); err != nil {
+		t.Fatalf("click the uninstall button: %v (texts %v)", err, tt.Texts())
+	}
+	tt.Frame()
+
+	label, ok := tt.Find(en.UninstallHostConfig)
+	if !ok {
+		t.Fatalf("the dialog is missing the host configuration label: %v", tt.Texts())
+	}
+	hint, ok := tt.Find(en.UninstallHostConfigHint)
+	if !ok {
+		t.Fatalf("the dialog is missing the host configuration hint: %v", tt.Texts())
+	}
+	var space float32
+	ui.NewTester(func(c *ui.Context) { space = c.Theme().Space(1) }, 100, 100).Frame()
+	wantGap := space // 4px
+	gotGap := hint.Y - (label.Y + label.H)
+	if absFloat(gotGap-wantGap) > 0.5 {
+		t.Errorf("the label/hint gap is %.1f, want %.1f (4px)", gotGap, wantGap)
+	}
+}
+
+// The two action buttons are 7px apart — the reference's
+// `.extensions-dialog-actions { gap: 7px }`
+// (`ComponentizedUninstallDialog.css:68-72`). The confirm button's X minus
+// the cancel button's right edge reads that gap.
+func TestComponentizedUninstallButtonGap(t *testing.T) {
+	en := i18n.For("en").Settings
+	a := newTestApp()
+	a.Actions = Actions{UninstallComponents: func(string, string, string, UninstallComponents) {}}
+	a.Integrations = func() []Integration {
+		return []Integration{{ID: "npm", Name: "NPM Tool", DistributionSource: "npm"}}
+	}
+	tt := render(t, a, 720, 1400)
+	if err := tt.Click("Integrations"); err != nil {
+		t.Fatalf("click Integrations: %v", err)
+	}
+	tt.Frame()
+	if err := tt.Click(en.IntegrationsUninstall + "…"); err != nil {
+		t.Fatalf("click the uninstall button: %v (texts %v)", err, tt.Texts())
+	}
+	tt.Frame()
+
+	cancel, ok := tt.Find(en.PermissionsCancel)
+	if !ok {
+		t.Fatalf("the dialog is missing Cancel: %v", tt.Texts())
+	}
+	confirm, ok := tt.Find(en.IntegrationsUninstall)
+	if !ok {
+		t.Fatalf("the dialog is missing the confirm button: %v", tt.Texts())
+	}
+	var space float32
+	ui.NewTester(func(c *ui.Context) { space = c.Theme().Space(1) }, 100, 100).Frame()
+	wantGap := space * 1.75 // 7px
+	gotGap := confirm.X - (cancel.X + cancel.W)
+	if absFloat(gotGap-wantGap) > 0.5 {
+		t.Errorf("the button gap is %.1f, want %.1f (7px)", gotGap, wantGap)
+	}
+}

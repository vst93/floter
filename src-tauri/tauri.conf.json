{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "floter",
  "version": "0.3.3-preview",
  "identifier": "com.v.floter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "floter",
        "width": 720,
        "height": 58,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "center": true,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; frame-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline' asset:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/app-icons/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "license": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/vst93/floter/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBMTBBNUEzQkJGNzEwQjYKUldTMkVQZTdvNlVRU2wvSW1qNWFERHRuYlJBR3dVQkl4bUsvcnltRENzbllpeEZkcWN6aDlUc00K",
      "dialog": true
    }
  }
}
